# Copiar a .env y completar. El archivo .env esta en .gitignore: nunca se versiona.

# --- Aplicacion -------------------------------------------------------------
# Endpoint alternativo POST JSON. Las consultas comerciales usan /api/lead
# por defecto (Bitrix en el servidor). El agendamiento de service continúa
# en WhatsApp si este valor está vacío.
VITE_LEADS_ENDPOINT=

# Solo en el servidor/runtime de Coolify. Reutilizar el webhook aprobado de Santa Rosa.
# Nunca usar prefijo VITE_ ni activar su inclusión durante el build.
BITRIX_WEBHOOK_URL=

# Dominio definitivo para canonical, sitemap, Open Graph y datos estructurados.
# Mantener el actual hasta definir el cambio de dominio. Sin barra final.
VITE_SITE_URL=https://gwmweb.santarosa.lat

# true para un entorno de pruebas público: añade noindex al HTML de todas las rutas.
VITE_NOINDEX=false

# ID público de Google Analytics 4, nunca una clave secreta.
# Sin ID no se carga analítica externa. Con ID, se pide elección de medición antes de cargarla.
VITE_GA_ID=

# --- Deploy (Coolify) -------------------------------------------------------
# OJO: estas variables NO llevan el prefijo VITE_. Todo lo que empieza con
# VITE_ queda embebido en el bundle que se descarga el navegador, asi que un
# token con ese prefijo quedaria publicado. Estas solo se usan desde la
# terminal para hablar con la API de Coolify.

# URL de la instancia de Coolify, sin barra final. Ej: https://coolify.midominio.com
COOLIFY_URL=

# Token de API de Coolify. Se genera en:
#   Keys & Tokens -> API tokens -> Create New Token
# Necesita permisos de escritura para crear la aplicacion y disparar el deploy.
COOLIFY_TOKEN=
